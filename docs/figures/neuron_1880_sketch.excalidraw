      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "STEP 2 \u00b7 build eye 1 (gate)\nrecord the thought on 1000s of training questions\nlabel each: answer missing / answer present\nlogistic regression finds the separating direction\n\u00d7 sharpness S \u2192 a switch, not a dimmer",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "STEP 2 \u00b7 build eye 1 (gate)\nrecord the thought on 1000s of training questions\nlabel each: answer missing / answer present\nlogistic regression finds the separating direction\n\u00d7 sharpness S \u2192 a switch, not a dimmer",
      "lineHeight": 1.25,
      "baseline": 17
    },
