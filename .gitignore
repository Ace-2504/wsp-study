wsp_runs/**
!wsp_runs/**/
!wsp_runs/**/*_numbers.json
!wsp_runs/**/*TABLES.md
!wsp_runs/**/chain.json
!wsp_runs/**/final.json
!wsp_runs/**/selection.json
!wsp_runs/**/drawn_actions.json
# env
.venv/
__pycache__/
*.pyc
.env
